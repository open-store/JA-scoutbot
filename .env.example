# Copy to .env and fill in locally. Never commit .env.
# Names only. See docs/operations/configuration.md.

# Slack (Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Snowflake session
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
SNOWFLAKE_RSA_KEY_PASSPHRASE=
# Production: PEM contents. Local dev: use SNOWFLAKE_RSA_KEY_PATH instead.
SNOWFLAKE_RSA_KEY_CONTENT=
SNOWFLAKE_RSA_KEY_PATH=

# Richpanel API (/daily)
RICHPANEL_API_KEY=

# Okendo reviews API
OKENDO_SUBSCRIBER_ID=
OKENDO_API_KEY=

# OpenAI (natural-language routing and product-feedback synthesis)
OPENAI_API_KEY=

# Optional. The OpenAI SDK reads this when set.
OPENAI_BASE_URL=

# Optional. Health-check listen port. Defaults to 8080.
PORT=

# Optional. "snowflake" enables Shopify order lookups for product attribution. Off when unset.
SCOUT_ORDER_LOOKUP=

# Not read by the current bot. Reserved names only.
KNOCOMMERCE_CLIENT_ID=
KNOCOMMERCE_SECRET=
REDO_API_KEY=
